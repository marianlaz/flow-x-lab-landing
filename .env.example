# Anthropic API key used by the /api/chat route to power the AI chat widget.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model used by the chat.
# Defaults to "claude-3-5-haiku-latest" when unset.
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
